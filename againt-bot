def main():
    if "ضع_توكن" in BOT_TOKEN:
        print("ضع توكن البوت في BOT_TOKEN أولاً.")
        return
    me = tg("getMe")
    os.makedirs(AGENTS_DIR, exist_ok=True)
    if not list_agents() and STORAGE_CHAT_ID:
        try:
            ok, m = do_restore()
            print("استعادة تلقائية:", m)
        except Exception as e:
            print("تعذّرت الاستعادة التلقائية:", e)
    active_agent()
    if not API_KEYS.get(cur_provider()):
        print("⚠️ لا يوجد مفتاح API للمزوّد %s." % cur_provider())
    threading.Thread(target=backup_loop, daemon=True).start()
    threading.Thread(target=scheduler_loop, daemon=True).start()
    print("✅ يعمل: @%s | المزوّد: %s | أوقفه بزر Stop" % (me.get("username"), cur_provider()))
    offset = None
    while True:
        try:
            ups = tg("getUpdates", {"timeout": 50, "offset": offset, "allowed_updates": ["message"]}, timeout=65)
            for u in ups:
                offset = u["update_id"] + 1
                try:
                    handle_update(u)
                except Exception as e:
                    traceback.print_exc()
                    try:
                        send_text(u["message"]["chat"]["id"], "⚠️ خطأ: %s" % e)
                    except Exception:
                        pass
        except requests.exceptions.RequestException as e:
            print("شبكة:", type(e).__name__)
            time.sleep(5)
        except KeyboardInterrupt:
            print("أُوقف.")
            break
        except Exception as e:
            print("خطأ:", e)
            time.sleep(3)


if __name__ == "__main__":
    main()
