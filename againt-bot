def cmd(chat_id, msg, text):
    parts = text.split(None, 1)
    c = parts[0].split("@")[0].lower()
    arg = parts[1].strip() if len(parts) > 1 else ""
    agent = active_agent()

    if c in ("/start", "/help"):
        send_text(chat_id, HELP)
    elif c == "/agents":
        send_text(chat_id, "\n".join(("▶️ " if a == agent else "• ") + a for a in list_agents()))
    elif c == "/new":
        if not NAME_RE.match(arg):
            return send_text(chat_id, "الاسم: حروف/أرقام/شرطة فقط، حتى 30 حرفاً. مثال: /new google-ads")
        with LOCK:
            ensure_agent(arg)
            set_setting("active", arg)
        send_text(chat_id, "✅ أُنشئ الوكيل «%s» وأصبح نشطاً.\nأرسل /setbrain لتعريف دوره، أو اشرح له مهمته مباشرة." % arg)
    elif c == "/use":
        if arg not in list_agents():
            return send_text(chat_id, "لا يوجد وكيل بهذا الاسم. /agents")
        set_setting("active", arg)
        send_text(chat_id, "▶️ الوكيل النشط الآن: " + arg)
    elif c == "/brain":
        send_file(chat_id, brain_path(agent))
    elif c == "/journal":
        send_file(chat_id, journal_path(agent)) if os.path.isfile(journal_path(agent)) else send_text(chat_id, "السجل فارغ بعد.")
    elif c == "/setbrain":
        if not arg:
            return send_text(chat_id, "أرسل: /setbrain ثم النص، أو ملف .md وفي تعليقه /setbrain")
        with LOCK:
            write_text(brain_path(agent) + ".bak", read_text(brain_path(agent)))
            write_text(brain_path(agent), arg + "\n")
            DIRTY.set()
        send_text(chat_id, "✅ تم تحديث عقل «%s» (النسخة القديمة محفوظة .bak)." % agent)
    elif c == "/files":
        fs = sorted(os.listdir(files_dir(agent)))
        send_text(chat_id, "\n".join("• %s (%d KB)" % (f, os.path.getsize(os.path.join(files_dir(agent), f)) // 1024) for f in fs) or "لا توجد ملفات.")
    elif c == "/getfile":
        p = os.path.join(files_dir(agent), safe_name(arg))
        send_file(chat_id, p) if os.path.isfile(p) else send_text(chat_id, "الملف غير موجود. /files")
    elif c == "/daily":
        meta = load_json(meta_path(agent), {})
        if not arg:
            return send_text(chat_id, "المهمة اليومية: %s %s" % (meta.get("daily_time", "—"), meta.get("daily_prompt", "")))
        if arg.lower() == "off":
            meta.pop("daily_time", None)
            meta.pop("daily_prompt", None)
            save_json(meta_path(agent), meta)
            return send_text(chat_id, "أُوقفت المهمة اليومية.")
        m = re.match(r"^(\d{1,2}):(\d{2})\s+(.+)$", arg, re.S)
        if not m or int(m.group(1)) > 23 or int(m.group(2)) > 59:
            return send_text(chat_id, "الصيغة: /daily 09:00 راجع ملفات اليوم وأرسل تقريراً")
        t = "%02d:%s" % (int(m.group(1)), m.group(2))
        meta.update({"daily_time": t, "daily_prompt": m.group(3).strip()})
        if now_local().strftime("%H:%M") >= t:   # لا تُشغَّل اليوم تلقائياً؛ استخدم /run للتجربة
            meta["last_daily"] = now_local().strftime("%Y-%m-%d")
        save_json(meta_path(agent), meta)
        DIRTY.set()
        send_text(chat_id, "✅ سيعمل «%s» يومياً عند %s (بتوقيتك)." % (agent, t))
    elif c == "/run":
        p = load_json(meta_path(agent), {}).get("daily_prompt")
        if not p:
            return send_text(chat_id, "لا توجد مهمة يومية. /daily 09:00 المهمة")
        deliver(chat_id, agent, DAILY_WRAP % p, title="▶️ تشغيل المهمة — " + agent)
    elif c == "/clear":
        log_hist(agent, "marker", "")
        send_text(chat_id, "🧹 مُسح السياق القصير. الأرشيف والذاكرة باقيان.")
    elif c == "/model":
        if not arg:
            return send_text(chat_id, "الحالي: %s / %s" % (cur_provider(), cur_model()))
        p = arg.split()
        if p[0] not in PROVIDERS:
            return send_text(chat_id, "المزوّدون: " + ", ".join(PROVIDERS))
        set_setting("provider", p[0])
        if len(p) > 1:
            models = get_setting("models", {})
            models[p[0]] = p[1]
            set_setting("models", models)
        warn = "" if API_KEYS.get(p[0]) else "\n⚠️ لا يوجد مفتاح API لهذا المزوّد في الإعدادات."
        send_text(chat_id, "✅ %s / %s%s" % (p[0], cur_model(p[0]), warn))
    elif c == "/backup":
        with LOCK:
            send_text(chat_id, do_backup())
    elif c == "/restore":
        if arg.lower() != "yes":
            return send_text(chat_id, "الاستعادة تستبدل البيانات الحالية. أرسل: /restore yes")
        with LOCK:
            ok, m = do_restore()
        send_text(chat_id, ("✅ " if ok else "⚠️ ") + m)
    elif c == "/status":
        send_text(chat_id, "الوكيل النشط: %s\nالمزوّد: %s / %s\nالوكلاء: %d\nآخر نسخة احتياطية: %s\nتغييرات غير محفوظة: %s"
                  % (agent, cur_provider(), cur_model(), len(list_agents()),
                     get_setting("last_backup", "—"), "نعم" if DIRTY.is_set() else "لا"))
    else:
        send_text(chat_id, "أمر غير معروف. /help")


def handle_file(chat_id, msg, agent):
    kind = next((k for k in ("document", "photo", "audio", "video", "voice") if msg.get(k)), None)
    if not kind:
        return False
    obj = msg[kind][-1] if kind == "photo" else msg[kind]
    if obj.get("file_size", 0) > 20 * 1024 * 1024:
        send_text(chat_id, "⚠️ الملف أكبر من 20MB وتيليجرام لا يسمح للبوتات بتنزيله.")
        return True
    name = safe_name(obj.get("file_name") or "%s_%s" % (kind, now_local().strftime("%Y%m%d_%H%M%S")) +
                     {"photo": ".jpg", "voice": ".ogg", "audio": ".mp3", "video": ".mp4"}.get(kind, ""))
    dest = os.path.join(files_dir(agent), name)
    if os.path.exists(dest):
        b, e = os.path.splitext(name)
        name = "%s_%s%s" % (b, now_local().strftime("%H%M%S"), e)
        dest = os.path.join(files_dir(agent), name)
    with LOCK:
        download_tg_file(obj["file_id"], dest)
        DIRTY.set()
    cap = (msg.get("caption") or "").strip()
    if cap.lower().startswith("/setbrain"):
        with LOCK:
            write_text(brain_path(agent) + ".bak", read_text(brain_path(agent)))
            write_text(brain_path(agent), read_any(dest) + "\n")
        send_text(chat_id, "✅ تم تعيين عقل «%s» من الملف." % agent)
    elif cap:
        deliver(chat_id, agent, "%s\n[أرسلتُ لك ملفاً حُفظ في مساحة عملك باسم: %s]" % (cap, name))
    else:
        with LOCK:
            log_hist(agent, "user", "[أرسل ملفاً: %s]" % name)
        send_text(chat_id, "📎 حُفظ «%s» في مساحة عمل «%s». اسألني عنه متى شئت." % (name, agent))
    return True


def handle_update(u):
    msg = u.get("message")
    if not msg:
        return
    uid, chat_id = msg["from"]["id"], msg["chat"]["id"]
    if not OWNER_ID:
        return send_text(chat_id, "رقمك في تيليجرام: %d\nضعه في OWNER_ID ثم أعد تشغيل البوت." % uid)
    if uid != OWNER_ID:
        return
    agent = active_agent()
    text = (msg.get("text") or "").strip()
    if handle_file(chat_id, msg, agent):
        return
    if text.startswith("/"):
        return cmd(chat_id, msg, text)
    if text:
        deliver(chat_id, agent, text)


